# Copy to .env and fill in. NEVER commit .env.

# STT (Sarvam) — https://dashboard.sarvam.ai
SARVAM_API_KEY=

# LLM for generation — pick one backend:
GROQ_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Vector DB (FAISS uses none; Qdrant only if enabled)
QDRANT_URL=
QDRANT_API_KEY=

# Pipeline options
STT_PROVIDER=sarvam        # sarvam | fake (fake = keyless dev)
STT_TIMEOUT_S=20           # total STT budget; half WS attempt + half REST fallback
LLM_PROVIDER=extractive    # extractive (offline default) | groq | openai
DATA_STRATEGY=metadata     # metadata is the measured best strategy
DATA_LANG=hi
DATA_SPLIT=validation
RETRIEVAL_TIMEOUT_S=30
PORT=8000
